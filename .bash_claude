# Claude setup
_claude_with_profile() {
    export CLAUDE_CONFIG_DIR="$1"
    shift
    # Replace --yolo with --dangerously-skip-permissions
    local args=()
    for arg in "$@"; do
        if [[ "$arg" == "--yolo" ]]; then
            args+=("--dangerously-skip-permissions")
        else
            args+=("$arg")
        fi
    done
    echo "starting claude with config dir $CLAUDE_CONFIG_DIR"
    command claude "${args[@]}"
}

# Personal profile (default)
claude() {
  _claude_with_profile "$HOME/.claude" "$@"
}

# Work profile
pclaude() {
  _claude_with_profile "$HOME/.claude-peregrine" "$@"
}
